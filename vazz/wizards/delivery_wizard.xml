<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="delivery_wizard_vazz_view_form" model="ir.ui.view">
        <field name="name">vazz.delivery.wizard.view.form</field>
        <field name="model">vazz.delivery.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="date_delibery" readonly="0" required="1"/>
                    <field name="total_pay" readonly="1" force_save="1"  widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="total_pending" readonly="1" force_save="1"  widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    
                    <field name="total" readonly="0" required="1"/>

                    <field name="is_total" invisible="1" readonly="1" force_save="1" />
                    <field name="currency_id" invisible="1" readonly="1" force_save="1" />
                </group>
                <group>
                    <footer>
                        <button name="confirm_delivery" string="Aceptar" type="object" class="oe_highlight"/>
                        <button string="Cancelar" class="btn btn-default" special="cancel"/>
                    </footer>
                </group>
            </form>
        </field>
    </record>
</odoo>