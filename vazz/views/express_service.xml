<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
    <!-- view tree -->
        <record id="express_service_vazz_view_tree" model="ir.ui.view">
            <field name="name">vazz.express.service.vazz.view_tree</field>
            <field name="model">vazz.express.service</field>
            <field name="arch" type="xml">
                <tree string="">
                    <field name="name"/>
                    <field name="customer_name"/>
                    <field name="phone"/>
                    <field name="description"/>
                </tree>
            </field>
        </record>

    <!-- view form -->
        <record id="express_service_view_form" model="ir.ui.view">
            <field name="name">vazz.express.service.vazz.view_form</field>
            <field name="model">vazz.express.service</field>
            <field name="arch" type="xml">
                <form string="Loan Registration" duplicate="false">
                    <header>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" readonly="1" force_save="1"/>
                                <field name="customer_name" required="1" readonly="0"/>
                                <field name="phone" required="1" readonly="0"/>
                                <field name="description" required="1" readonly="0"/>
                            </group>
                            <group></group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" />
                        <field name="activity_ids" widget="mail_activity" />
                        <field name="message_ids" widget="mail_thread" />
                    </div>
                </form>
            </field>
        </record>
    </data>

    <!-- main screen  -->
        <record id="action_express_service_vazz" model="ir.actions.act_window">
            <field name="name">Servicio expréss</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">vazz.express.service</field>
            <field name="view_mode">tree,form,activity</field>
            <field name="context">{
                'tree_view_ref':'vazz.express_service_vazz_view_tree',
                'form_view_ref':'vazz.express_service_view_form',
                }</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Solicitud de servicio expréss</p>
            </field>
        </record>
</odoo>