<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
    <!-- view tree -->
        <record id="customers_phone_vazz_tree" model="ir.ui.view">
            <field name="name">vazz.customers.phone.vazz.tree</field>
            <field name="model">vazz.customers.phone</field>        
            <field name="arch" type="xml">
                <tree string="Teléfono">
                    <field name="name"/>
                    <field name="is_main"/>
                </tree>
            </field>
        </record>

    <!-- view form -->
        <record id="customers_phone_vazz_form" model="ir.ui.view">
            <field name="name">vazz.customers.phone.vazz.form</field>
            <field name="model">vazz.customers.phone</field> 
            <field name="arch" type="xml">
                <form string="Loan Registration" duplicate="false">
                    <header>
                        <button string="Principal" name="button_is_main"  class="oe_highlight" type="object"
                            attrs="{'invisible' : [('is_main', '=', True)]}"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" readonly="0" required ="1"/>
                                <field name="customer_ids"  readonly="1" invisible="1" force_save="1"/>
                                <field name="is_main" readonly="1"/>
                            </group>
                            <group></group>
                        </group>
                    </sheet>

                </form> 
            </field>
        </record>
    </data>
</odoo>