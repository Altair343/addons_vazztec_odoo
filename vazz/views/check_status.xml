                </form>
            </field>
        </record>


    <!-- main screen  -->
        <record id="action_check_status_vazz" model="ir.actions.act_window">
            <field name="name">Check status express</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">vazz.check.status</field>
            <field name="view_mode">list,form,activity</field>
            <field name="context">{
                'list_view_ref':'vazz.check_status_view_list',
                'form_view_ref':'vazz.check_status_view_form',
                }</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Check status express Funcionamiento equipo</p>
            </field>
        </record>
    </data>
</odoo>