<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
    <!-- view list -->
        <record id="customers_vazz_list" model="ir.ui.view">
            <field name="name">vazz.customers.vazz.list</field>
            <field name="model">vazz.customers</field>        
            <field name="arch" type="xml">
                <list string="Clientes">
                    <field name="folio"/>
                    <field name="name"/>
                    <field name="phone"/>
                    <field name="email"/>
                </list>
            </field>
        </record>

    <!-- view form -->
        <record id="customers_vazz_form" model="ir.ui.view">
            <field name="name">vazz.customers.vazz.form</field>
            <field name="model">vazz.customers</field> 
            <field name="arch" type="xml">
                <form string="Loan Registration" duplicate="false">
                    <sheet>
                        <group>
                            <group>
                                <field name="folio" readonly="1" required ="1"/>
                                <field name="name" readonly="1" invisible="1"/>
                                <field name="user_name" readonly="0" required ="1"/>
                                <field name="surname" readonly="0" required ="1"/>
                                <field name="second_surname" readonly="0"/>
                                <field name="count_services" readonly="1"/>
                                <field name="is_group_rol002" invisible="1"/>
                            </group>
                            <group>
                                <field name="phone" readonly="1" options="{'no_create': True, 'no_create_edit':True,'no_open':True}"
                                    attrs="{'invisible' : [('is_group_rol002', '=', True)]}"/>
                                <br/>
                                <field name="email" readonly="0"/>
                            </group>
                        </group>
                        <group>
                            <field name="addres" readonly="0"/>
                        </group>
                        <label for="phones_ids" string="Teléfonos" attrs="{'invisible' : [('is_group_rol002', '=', True)]}"/>
                        <field name="phones_ids" readonly="0"
                            attrs="{'invisible' : [('is_group_rol002', '=', True)]}"
                            context="{'request_id': id }">
                            <list string="Number">
                                <field name="name" required ="1"/>
                                <field name="is_main"  readonly="1" force_save="1"/>
                            </list>
                        </field>

                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" />
                        <field name="activity_ids" widget="mail_activity" />
                        <field name="message_ids" widget="mail_thread" />
                    </div>
                </form> 
            </field>
        </record>

    <!-- main screen  -->
        <record id="action_customers_vazz" model="ir.actions.act_window">
            <field name="name">Clientes</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">vazz.customers</field>
            <field name="view_mode">list,form,activity</field>
            <field name="context">{
                'list_view_ref':'vazz.customers_vazz_list',
                'form_view_ref':'vazz.customers_vazz_form',
                }</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Clientes</p>
            </field>
        </record>
    </data>
</odoo>