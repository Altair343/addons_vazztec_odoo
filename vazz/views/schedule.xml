<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
    <!-- view list -->
        <record id="schedule_vazz_list" model="ir.ui.view">
            <field name="name">vazz.schedule.vazz.list</field>
            <field name="model">vazz.schedule</field>        
            <field name="arch" type="xml">
                <list string="Clientes" default_order='id desc'>
                    <field name="id" invisible="1"/>
                    <field name="name"/>
                    <field name="service_ids"/>
                    <field name="customer_id"/>
                    <field name="type_schedule_id"/>
                    <field name="description"/>
                </list>
            </field>
        </record>

    <!-- view form -->
        <record id="schedule_vazz_form" model="ir.ui.view">
            <field name="name">vazz.schedule.vazz.form</field>
            <field name="model">vazz.schedule</field> 
            <field name="arch" type="xml">
                <form string="Loan Registration" duplicate="false">
                <header>
                    <button string="Listo" name="action_ok" class="oe_highlight" type="object"
                        invisible = "state not in ('pending')"/>

                    <button string="Regresar a Pendiente" groups="vazz.vazz_admin" name="action_pending" class="oe_highlight" type="object"
                        invisible = "state not in ('ok','cancel')"/>

                    <button string="Cancelar" name="cancel_wizard" class="oe_highlight" type="object"
                        invisible = "state not in ('pending')"/>
                    
                    <field name="state" widget="statusbar" readonly="1" statusbar_visible="aux"/>
                </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" readonly="1" force_save="1"/>
                                <field name="customer_id" required="1" readonly = "state not in ('draft','pending')"/>
                                <field name="telephone_cus" required="1" options="{'no_open':True}"
                                    readonly = "state not in ('draft','pending')"
                                    invisible = "is_group_rol002"
                                    context="{'type_register': 'service', 'default_customer_ids':customer_id }"/>
                                <field name="type_schedule_id" required ="1"
                                    options="{'no_create': True, 'no_create_edit':True,'no_open':True}"
                                    readonly = "state not in ('draft','pending')"/>
                                <field name="code_schedule" invisible="1"/>
                                <field name="is_group_rol002" invisible="1"/>
                            </group>
                            <group>
                                <field name="state_aux"  readonly="1"/>
                                <field name="date_scheduled" required ="1"
                                readonly = "state not in ('draft','pending')"/>
                                <field name="hour_scheduled" 
                                readonly = "state not in ('draft','pending')"/>

                            </group>
                        </group>
                        <group>
                            <field name="addres"
                                readonly = "state not in ('draft','pending')"
                                invisible = "code_schedule != 'A'"
                                required = "code_schedule == 'A'"/>
                            <field name="description" 
                                readonly = "state not in ('draft','pending')"/>
                        </group>
                        
                        
                        
                        <notebook>
                        <page name="services" string="Servicios">
                            <label for="service_ids" string="Servicios"/>
                            <field name="service_ids" 
                                readonly = "state not in ('draft','pending')"
                                options="{'no_create': True}" 
                                context="{
                                    'list_view_ref':'vazz.servicios_vazz_list',
                                    'form_view_ref':'vazz.service_vazz_view_form',
                                }"/>
                        </page>
                            <page name="cancel" string="Cancelación">
                                <group>
                                    <field name="cancel_request" nolabel="1" readonly="1">
                                        <list string="Cancelaciones" >
                                            <field name="cancel_date"/>
                                            <field name="comment" string="Comentario"/>
                                            <field name="write_uid" string ="Útima modificación por"/>
                                        </list>
                                    </field>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" />
                        <field name="activity_ids" widget="mail_activity" />
                        <field name="message_ids" widget="mail_thread" />
                    </div>
                </form> 
            </field>
        </record>

    <!-- main screen  -->
        <record id="action_schedule_vazz" model="ir.actions.act_window">
            <field name="name">Agenda</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">vazz.schedule</field>
            <field name="view_mode">list,form,activity</field>
            <field name="context">{
                'list_view_ref':'vazz.schedule_vazz_list',
                'form_view_ref':'vazz.schedule_vazz_form',
                }</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Agenda</p>
            </field>
        </record>
    </data>
</odoo>