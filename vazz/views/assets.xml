<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
    <!-- view tree -->
        <record id="orders_assets_vazz_tree" model="ir.ui.view">
            <field name="name">vazz.orders.assets.vazz.tree</field>
            <field name="model">vazz.orders.assets</field>        
            <field name="arch" type="xml">
                <tree string="Anticipo">
                    <field name="name" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="date_delivery"/>
                    <field name="currency_id" invisible="1"/>
                </tree>
            </field>
        </record>

    <!-- view form -->
        <record id="orders_assets_vazz_form" model="ir.ui.view">
            <field name="name">vazz.orders.assets.vazz.form</field>
            <field name="model">vazz.orders.assets</field> 
            <field name="arch" type="xml">
                <form string="Loan Registration">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="0" required ="1"/>
                                <field name="date_delivery" readonly="0" required ="1"/>
                                <field name="order_id" readonly="1" invisible="1" force_save="1"/>
                                <field name="service_id" readonly="1" invisible="1" force_save="1"/>
                                <field name="currency_id" invisible="1" readonly="1" force_save="1" />
                            </group>
                            <group>
                                <field name="note" readonly="0"/>
                            </group>
                        </group>
                    </sheet>
                </form> 
            </field>
        </record>
    </data>
</odoo>