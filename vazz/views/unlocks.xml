<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
    <!-- view tree -->
        <record id="unlocks_vazz_tree" model="ir.ui.view">
            <field name="name">vazz.unlocks.vazz.tree</field>
            <field name="model">vazz.unlocks</field>        
            <field name="arch" type="xml">
                <tree string="Desbloqueos">
                    <field name="name"/>
                    <field name="service_id"/>
                    <field name="customer_id"/>
                    <field name="type_id"/>
                </tree>
            </field>
        </record>

    <!-- view form -->
        <record id="unlocks_vazz_form" model="ir.ui.view">
            <field name="name">vazz.unlocks.vazz.form</field>
            <field name="model">vazz.unlocks</field> 
            <field name="arch" type="xml">
                <form string="Loan Registration">
                    <header>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" readonly="1" required ="1"/>
                                <field name="service_id" readonly="1"/>
                                <field name="customer_id" required="1" readonly="1"/>
                            </group>
                            <group>
                                <field name="type_id" required="1" readonly="1" options="{'no_create': True, 'no_create_edit':True,'no_open':True}"/>
                                <field name="type_register" invisible="1"/>
                            </group>
                        </group>
                        <group>
                            
                        </group>
                    </sheet>
                </form> 
            </field>
        </record>

    <!-- main screen  -->
        <record id="action_unlocks_vazz" model="ir.actions.act_window">
            <field name="name">Desbloqueos</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">vazz.unlocks</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{
                'search_default_state':1,
                'tree_view_ref':'vazz.unlocks_vazz_tree',
                'form_view_ref':'vazz.unlocks_vazz_form',
                }</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Desbloqueos</p>
            </field>
        </record>

    <!-- Permisos -->
        <record id="unlocks_vazz_tree_inherit_general" model="ir.ui.view">
            <field name="name">vazz.unlocks.tree.inherit.general</field>
            <field name="model">vazz.unlocks</field>
            <field name="inherit_id" ref="vazz.unlocks_vazz_tree" />
            <field name="arch" type="xml">
                <xpath expr="/tree" position="attributes">
                    <attribute name="create">false</attribute>
                    <attribute name="edit">false</attribute>
                    <attribute name="delete">false</attribute>
                    <attribute name="duplicate">false</attribute>
                </xpath>
            </field>
        </record>

        <record id="unlocks_vazz_form_inherit_general" model="ir.ui.view">
            <field name="name">vazz.unlocks.form.inherit.general</field>
            <field name="model">vazz.unlocks</field>
            <field name="inherit_id" ref="vazz.unlocks_vazz_form" />
            <field name="arch" type="xml">
                <xpath expr="/form" position="attributes">
                    <attribute name="create">false</attribute>
                    <attribute name="edit">false</attribute>
                    <attribute name="delete">false</attribute>
                    <attribute name="duplicate">false</attribute>
                </xpath>
            </field>
        </record> 
    </data>
</odoo>