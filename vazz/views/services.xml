<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
    <!-- view list -->
        <record id="servicios_vazz_list" model="ir.ui.view">
            <field name="name">vazz.services.vazz.list</field>
            <field name="model">vazz.services</field>        
            <field name="arch" type="xml">
                <list string="Servicios" 
                    decoration-success="is_delivery == 'yes' and state == 'repaired'" 
                    decoration-warning="is_delivery == 'not' and state == 'repaired'"
                    decoration-danger="state == 'pending'" 
                    decoration-muted="state == 'cancel'"
                    decoration-primary="state == 'diagnosed'"
                    >
                    <field name="name"/>
                    <field name="customer_ids"/>
                    <field name="brand"/>
                    <field name="model_e"/>

                    <field name="date_reception"/>
                    <field name="state" widget="statusbar" statusbar_visible="0" />
                    <field name="is_delivery"/>
                    <field name="warning_notify"/>
                </list>
            </field>
        </record>

    <!-- view form -->
        <record id="service_vazz_view_form" model="ir.ui.view">
            <field name="name">vazz.service.vazz.view.form</field>
            <field name="model">vazz.services</field> 
            <field name="arch" type="xml">
                <form string="Loan Registration" duplicate="false">
                    <header>
                        <button string="Procesar equipo" name="action_process" 
                            invisible = "state not in ('pending')" class="oe_highlight" type="object"/>
                        
                        <button string="Equipo diagnostico" name="action_diagnosed" 
                            invisible = "state not in ('in_process')" class="oe_highlight" type="object"
                            confirm="El servicio solo será diagnosticado, ¿desea continuar?"/>
                        
                        <button string="Confirmar Reparación" name="action_repaired" 
                            invisible = "state not in ('in_process')" class="oe_highlight" type="object"
                            confirm="El servicio fue reparado, ¿desea continuar?"/>
                        
                        <button string="Equipo sin Solución" name="action_not_solution" 
                            invisible = "state not in ('in_process')" class="oe_highlight" type="object"
                            confirm="El servicio no fue reparado, ¿desea continuar?"/>
                        
                        <button string="Entregar equipo" name="action_delivery_yes" class="oe_highlight" type="object"
                            invisible = "state in ('draft','diagnosed','repaired','not_solution','cancel' or is_delivery not in ('not'))"/>

                        <button string="Cancelar" name="cancel_wizard" class="oe_highlight btn-danger" type="object"
                            invisible = "state in ('draft','diagnosed','repaired','not_solution','cancel')"/>

                        <field name="state" widget="statusbar" readonly="1" statusbar_visible="aux"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" placeholder="No. Servicio" readonly="1" force_save="1"/>
                                <field name="customer_ids" required="1" 
                                    readonly = "is_delivery == 'yes'"/>
                                <field name="telephone_cus" options="{'no_open':True}" 
                                    readonly = "state not in ('draft','pending')"
                                    invisible = "is_group_rol002"
                                    required = "not is_group_rol002 and code_type_notification == 'A'"
                                    context="{'type_register': 'service', 'default_customer_ids':customer_ids }"/>
                                <field name="date_reception" required="1" 
                                    readonly = "state not in ('draft')"/>
                                <field name="type_service" required="1"
                                    readonly = "state not in ('draft','pending')"/>
                                <field name="type_notification_id" required="1" options="{'no_create': True, 'no_create_edit':True,'no_open':True}"
                                    readonly = "state not in ('draft','pending')"/>
                                <field name="code_type_notification" readonly="1" invisible="1"/>
                                <field name="is_group_rol002" invisible="1"/>
                                
                            </group>
                            <group string="Ingreso">
                                <field name="type_entry" required="1"
                                    readonly = "state not in ('draft','pending')"/>
                                <field name="addres_entry" readonly = "state not in ('draft','pending')"
                                    invisible = "type_entry != 'harvest'" required = "type_entry == 'harvest'"/>
                                <field name="state_aux" readonly="1"/>

                                <field name="question_check_status" readonly = "state not in ('draft','pending')"
                                    required = "state in ('draft','pending')"/>
                                <field name="question_question_check" readonly = "state not in ('draft','pending')"
                                    invisible = "question_check_status != 'not'" required = "question_check_status == 'not'"/>
                            </group>
                        </group>
                        <group>
                            <field name="description" required="1"
                                readonly = "state not in ('draft','pending')"/>
                            <field name="observations" readonly = "state not in ('draft','pending','in_process')"/>
                        </group>
                        <group>
                            <group string="Equipo">
                                <field name="brand" required="1"
                                    readonly = "state not in ('draft','pending')"/>
                                <field name="model_e" required="1"
                                    readonly = "state not in ('draft','pending')"/>
                                <field name="imei"
                                    readonly = "state not in ('draft','pending')"/>
                                <field name="type_equipment" required="1" options="{'no_create': True, 'no_create_edit':True,'no_open':True}"
                                    readonly = "state not in ('draft','pending')"/>
                                <field name="password"
                                    readonly = "state not in ('draft','pending')"/>
                                <field name="question_acce"
                                    readonly = "state not in ('draft','pending')" required="1"/>
                                
                                <field name="accessories" readonly = "state not in ('draft','pending')"
                                    invisible = "question_acce != 'yes'" required = "question_acce == 'yes'"/>
                            </group>
                            <group string="Entrega">
                                <field name="date_approximate_delivery" required="1" 
                                    readonly = "state not in ('draft','pending')"/>
                                <field name="type_delivery" required="1"
                                    readonly = "state not in ('draft','pending')"/>
                                <field name="addres" readonly = "state not in ('draft','pending')"
                                    invisible = "type_delivery != 'home'" required = "type_delivery == 'home'"/>
                                <br/>
                                <field name="technical_id"  options="{'no_create': True, 'no_create_edit':True,'no_open':True}"
                                    readonly = "state not in ('in_process')"/>
                                <field name="date_delibery" readonly="1" force_save="1" />
                                    <!-- ('is_delivery', 'not in', ('not')) -->
                                <field name="is_delivery" readonly="1" force_save="1" />
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="estimated_cost" required="1"  widget="monetary" options="{'currency_field': 'currency_id'}"
                                    readonly = "state not in ('draft','pending','in_process')"/>
                                <field name="total" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="total_assets" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="total_pending" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            </group>
                            <group >
                                <field name="assets_ids"
                                    readonly = "state not in ('draft','pending','in_process','diagnosed','repaired','not_solution')"/>
                                <field name="total_assets_ser" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            </group>
                        </group>
                        <label for="diagnostic_ids" string="Diagnósticos"/>
                        <field name="diagnostic_ids" 
                            readonly = "state not in ('draft','pending','in_process','diagnosed','repaired','not_solution')"
                            context="{'type_register': 'service','default_state':state}"/>
                        <br/>
                        <label for="concepts_ids" string="Conceptos"/>
                        <field name="concepts_ids"
                            readonly = "state not in ('draft','pending','in_process','diagnosed','repaired','not_solution')"
                            context="{'type_register': 'service','default_state':state}"/>
                        <notebook>
                            <page name="pedidos" string="Pedidos" >
                                <group>
                                    <group>
                                        <field name="total_pay_order" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" />
                                        <field name="total_assets_order" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" />
                                        <field name="currency_id" invisible="1" readonly="1" force_save="1" />
                                    </group>
                                </group>
                                <label for="orders_ids" string="Pedidos"/>
                                <field name="orders_ids" context="{  'type_register': 'service' }"
                                    readonly = "state not in ('draft','pending','in_process','diagnosed','repaired','not_solution')"/>
                            </page>
                            <page name="desbloqueos" string="Desbloqueos" >
                                <label for="unlocks_ids" string="Desbloqueos"/>
                                <field name="unlocks_ids" 
                                    readonly = "state not in ('draft','pending','in_process','diagnosed','repaired','not_solution')"
                                    context="{ 
                                        'type_register': 'service',
                                        'list_view_ref':'vazz.unlocks_vazz_list_rol',
                                        'form_view_ref':'vazz.unlocks_vazz_form_rol',
                                    }"/>
                            </page>
                            <page name="garantias" string="Garantías" >
                                <group>
                                    <group>
                                        <field name="question_warranty" 
                                            readonly = "state not in ('in_process')"/>
                                        <field name="question_whats" readonly = "state not in ('in_process')"
                                            invisible = "question_warranty != 'not'" required = "question_warranty == 'not'"/>
                                    </group>
                                </group>
                                <label for="warranty_ids" string="Garantías"/>
                                <field name="warranty_ids" 
                                    readonly = "state not in ('in_process','diagnosed','repaired','not_solution')"
                                    context="{  'type_register': 'service' }" />
                            </page>
                            <page name="notifications" string="Notificaciones">
                                <group>
                                </group>
                                <label for="notifications_ids" string="Notificaciones"/>
                                <field name="notifications_ids" 
                                    readonly = "state not in ('draft','pending','in_process','diagnosed','repaired','not_solution')"/>
                            </page>
                            <page name="check_status_data" string="Check status express" >
                                <label for="check_status_ids" string="Check status express"/>
                                <field name="check_status_ids"
                                    readonly = "state not in ('draft','pending','in_process','diagnosed','repaired','not_solution')"
                                    context="{
                                        'type_register': 'service',
                                        'form_view_ref':'vazz.check_status_view_form_alt',}"/>
                            </page>
                            <page name="cancel" string="Cancelación">
                                <group>
                                    <field name="cancel_request" nolabel="1" readonly="1">
                                        <list string="Cancelaciones" >
                                            <field name="cancel_date"/>
                                            <field name="comment" string="Comentario"/>
                                            <field name="write_uid" string ="Útima modificación por"/>
                                        </list>
                                    </field>
                                </group>
                            </page>
                            <page name="history" string="Historial de Estados">
                                <field name="state_history_ids" readonly="1" 
                                    context="{  
                                        'type_register': 'service', 
                                        'list_view_ref':'vazz.service_state_history_vazz_list',
                                        }" />
                            </page>
                        </notebook>
                        <div invisible="1">
                            <script type="text/javascript">
                                var input_upload = document.querySelectorAll(".o_form_binary_progress");
                                for (var index = 0; index &lt; input_upload.length; index++){ input_upload[index].classList.remove('o_hidden'); }
                            </script>
                        </div>
                    </sheet>
                    <chatter/>
                </form> 
            </field>
        </record>

    <!-- main screen  -->
        <record id="action_servicios_vazz" model="ir.actions.act_window">
            <field name="name">Servicios</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">vazz.services</field>
            <field name="view_mode">list,form,activity</field>
            <field name="context">{
                'list_view_ref':'vazz.servicios_vazz_list',
                'form_view_ref':'vazz.service_vazz_view_form',
                }</field>
            <field name="domain">[('is_archive', '=', 'not')]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Solicitud de Servicio</p>
            </field>
        </record>

        <record id="action_servicios_archive_vazz" model="ir.actions.act_window">
            <field name="name">Archivados</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">vazz.services</field>
            <field name="view_mode">list,form,activity</field>
            <field name="context">{
                'list_view_ref':'vazz.servicios_archive_vazz_list',
                'form_view_ref':'vazz.service_archive_vazz_view_form',
                }</field>
            <field name="domain">[('is_archive', '=', 'yes')]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Solicitud de Servicio</p>
            </field>
        </record>
    </data>
</odoo>