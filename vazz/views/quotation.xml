<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
    <!-- view list -->
        <record id="quotation_vazz_list" model="ir.ui.view">
            <field name="name">vazz.quotation.vazz.list</field>
            <field name="model">vazz.quotation</field>        
            <field name="arch" type="xml">
                <list string="Cotización">
                    <field name="name"/>
                    <field name="customer_id"/>
                    <field name="date"/>
                </list>
            </field>
        </record>

    <!-- view form -->
        <record id="quotation_vazz_form" model="ir.ui.view">
            <field name="name">vazz.quotation.vazz.form</field>
            <field name="model">vazz.quotation</field> 
            <field name="arch" type="xml">
                <form string="Loan Registration" duplicate="false">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" readonly="1" required ="1" force_save="1"/>
                                <field name="date" readonly="1" required ="1" force_save="1"/>
                                <field name="customer_id" readonly="0" required ="1"/>
                            </group>
                            <group></group>
                        </group>
                        <field name="product_ids" widget="section_and_note_one2many" mode="list" readonly="0" context="{'request_id': id}">
                            <list string="Number" editable="bottom">
                                <control>
                                    <create name="add_number" string="Agregar producto"/>
                                </control>
                                <field name="quantity" required ="1"/>
                                <field name="description" required ="1"/>
                                <field name="unit_price" required ="1"/>
                                <field name="amount"/>
                            </list>
                        </field>
                        <group>
                            <group></group>
                            <group>
                                <field name="total" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="currency_id" invisible="1" readonly="1" force_save="1" />
                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form> 
            </field>
        </record>

    <!-- main screen  -->
        <record id="action_quotation_vazz" model="ir.actions.act_window">
            <field name="name">Cotización</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">vazz.quotation</field>
            <field name="view_mode">list,form,activity</field>
            <field name="context">{
                'list_view_ref':'vazz.quotation_vazz_list',
                'form_view_ref':'vazz.quotation_vazz_form',
                }</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Cotización</p>
            </field>
        </record>
    </data>
</odoo>