<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
    <!-- view tree -->
        <record id="quotation_vazz_tree" model="ir.ui.view">
            <field name="name">vazz.quotation.vazz.tree</field>
            <field name="model">vazz.quotation</field>        
            <field name="arch" type="xml">
                <tree string="Cotización">
                    <field name="name"/>
                    <field name="customer_id"/>
                    <field name="date"/>
                </tree>
            </field>
        </record>

    <!-- view form -->
        <record id="quotation_vazz_form" model="ir.ui.view">
            <field name="name">vazz.quotation.vazz.form</field>
            <field name="model">vazz.quotation</field> 
            <field name="arch" type="xml">
                <form string="Loan Registration" duplicate="false">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" readonly="1" required ="1" force_save="1"/>
                                <field name="date" readonly="1" required ="1" force_save="1"/>
                                <field name="customer_id" readonly="0" required ="1"/>
                            </group>
                            <group></group>
                        </group>
                        <field name="product_ids" readonly="0" context="{'request_id': id}"/>
                        <group>
                            <group></group>
                            <group>
                                <field name="total" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="currency_id" invisible="1" readonly="1" force_save="1" />
                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" />
                        <field name="activity_ids" widget="mail_activity" />
                        <field name="message_ids" widget="mail_thread" />
                    </div>
                </form> 
            </field>
        </record>

    <!-- main screen  -->
        <record id="action_quotation_vazz" model="ir.actions.act_window">
            <field name="name">Cotización</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">vazz.quotation</field>
            <field name="view_mode">tree,form,activity</field>
            <field name="context">{
                'tree_view_ref':'vazz.quotation_vazz_tree',
                'form_view_ref':'vazz.quotation_vazz_form',
                }</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Cotización</p>
            </field>
        </record>
    </data>
</odoo>