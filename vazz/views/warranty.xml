<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
    <!-- view tree -->
        <record id="warranty_vazz_tree" model="ir.ui.view">
            <field name="name">vazz.warranty.vazz.tree</field>
            <field name="model">vazz.warranty</field>        
            <field name="arch" type="xml">
                <tree string="Garantías">
                    <field name="name"/>
                    <field name="description"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="service_id"/>
                    <field name="customer_id"/>
                    <field name="state"/>
                    <field name="validity"/>
                </tree>
            </field>
        </record>

    <!-- view form -->
        <record id="warranty_vazz_form" model="ir.ui.view">
            <field name="name">vazz.warranty.vazz.form</field>
            <field name="model">vazz.warranty</field> 
            <field name="arch" type="xml">
                <form string="Loan Registration">
                    <header>
                        <button string="Cancelar" name="cancel_lost" class="oe_highlight" type="object"
                            attrs="{'invisible' : ['|',('validity', 'in', ('lost')),('state', 'in', ('draft','expired'))]}"/>
                        
                        <button string="Activar" name="action_valid" class="oe_highlight" type="object"
                            attrs="{'invisible' : ['|',('validity', 'in', ('valid')),('state', 'in', ('draft','expired'))]}"/>

                        <field name="state" widget="statusbar" readonly="1" statusbar_visible="active"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" readonly="1" required ="1"/>
                                <field name="service_id" attrs="{'readonly' : [('state', 'in', ('expired'))], 'invisible' : [('type_register', '=','service')]}" force_save="1"/>
                                <field name="customer_id" required="1" attrs="{'readonly' : [('state', 'in', ('expired'))]}"/>
                                <field name="validity" readonly="1" force_save="1" />
                                <field name="type_register" invisible="1"/>
                            </group>
                            <group>
                                <field name="date_start" required="1" attrs="{'readonly' : [('state', 'in', ('expired'))]}"/>
                                <field name="date_end" required="1" attrs="{'readonly' : [('state', 'in', ('expired'))]}"/>
                                <field name="amount_days" readonly="1" force_save="1"/>
                            </group>
                        </group>
                        <group>
                            <field name="description" required="1" attrs="{'readonly' : [('state', 'in', ('expired'))]}"/>
                        </group>
                        <notebook>
                            <page name="cancel" string="Cancelación">
                                <group>
                                    <field name="cancel_request" nolabel="1" readonly="1">
                                        <tree string="Cancelaciones" >
                                            <field name="cancel_date"/>
                                            <field name="comment" string="Comentario"/>
                                            <field name="write_uid" string ="Útima modificación por"/>
                                        </tree>
                                    </field>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" />
                        <field name="activity_ids" widget="mail_activity" />
                        <field name="message_ids" widget="mail_thread" />
                    </div>
                </form> 
            </field>
        </record>

    <!-- main screen  -->
        <record id="action_warranty_vazz" model="ir.actions.act_window">
            <field name="name">Garantías</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">vazz.warranty</field>
            <field name="view_mode">tree,form,activity</field>
            <field name="context">{
                'tree_view_ref':'vazz.warranty_vazz_tree',
                'form_view_ref':'vazz.warranty_vazz_form',
                }</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Garantías</p>
            </field>
        </record>
    </data>
</odoo>