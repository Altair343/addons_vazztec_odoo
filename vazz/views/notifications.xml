<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    <!-- view list -->
        <record id="notifications_vazz_list" model="ir.ui.view">
            <field name="name">vazz.notifications.vazz.list</field>
            <field name="model">vazz.notifications</field>        
            <field name="arch" type="xml">
                <list string="Notificaciones">
                    <field name="type_id"/>
                    <field name="date_notification"/>
                    <field name="note"/>
                </list>
            </field>
        </record>

    <!-- view form -->
        <record id="vazz.notifications_view_form" model="ir.ui.view">
            <field name="name">vazz.notifications.view.form</field>
            <field name="model">vazz.notifications</field>
            <field name="arch" type="xml">
                <form string="Notificaciones">
                    <sheet>
                        <group>
                            <group>
                                <field name="type_id" readonly="0" required ="1" options="{'no_open':True,'no_create': True, 'no_create_edit':True}"/>
                                <field name="date_notification" readonly="0" required ="1"/>
                                <field name="order_id"  readonly="1" invisible="1" force_save="1"/>
                                <field name="service_id"  readonly="1" invisible="1" force_save="1"/>
                            </group>
                            <group>
                                <field name="note" readonly="0" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>