<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
    <!-- view tree -->
        <record id="servicios_archive_vazz_tree" model="ir.ui.view">
            <field name="name">vazz.services.vazz.tree</field>
            <field name="model">vazz.services</field>
            <field name="mode">primary</field>
            <field name="inherit_id" ref="vazz.servicios_vazz_tree"/>
            <field name="arch" type="xml">
                <tree position="attributes">
                    <attribute name="create">false</attribute>
                    <attribute name="edit">false</attribute>
                    <attribute name="delete">false</attribute>
                    <attribute name="duplicate">false</attribute>
                </tree>
            </field>
        </record>

    <!-- view form -->
        <record id="service_archive_vazz_view_form" model="ir.ui.view">
            <field name="name">vazz.service.archive.vazz.view.form</field>
            <field name="model">vazz.services</field>
            <field name="inherit_id" ref="vazz.service_vazz_view_form"/>
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <xpath expr="/form" position="attributes">
                    <attribute name="create">false</attribute>
                    <attribute name="edit">false</attribute>
                    <attribute name="delete">false</attribute>
                    <attribute name="duplicate">false</attribute>
                </xpath>

                <header position="replace">
                    <header>
                        <button string="Desarchivar" name="action_archive" class="oe_highlight" type="object"/>
                        <field name="state" widget="statusbar" readonly="1" statusbar_visible="aux"/>
                    </header>
                </header>

            </field>
        </record>
    </data>
</odoo>