<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="service_ticket_temple">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <style>
                        .oe_initial{
                            color: #249e6b;
                        }

                        .oe_pie{
                            font-size: .8rem;
                        }
                    </style>
                    <div class="header">
                        <div class="container mw-100 mb-2 text-center">
                            <div class="row"></div>
                        </div>
                    </div>
                    <div class="page">
                        <table class="container mw-100 mb-2 text-center" style="width:100%">
                            <thead>
                                <tr style="width:100%;">
                                    <th name="th_logo" colspan="2">
                                        <img src="/vazz/static/src/img/Logo_Web.png" width="220px" height = "auto"/>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td colspan="2">
                                        <span>TEL: 982-127-2503</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="container mw-100 mb-2 text-center">
                            <table class="table-bordered;" style="border:1px solid black !important; width:100%" border="1px">
                                <thead>
                                    <tr>
                                        <th name="th_folio">FOLIO SERVICIO</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>
                                            <span t-esc="doc.name" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <span>FECHA Y HORA DE RECEPCIÓN</span> <br/>
                                            <span t-esc="context_timestamp(doc.date_reception).strftime('%d/%m/%Y %H:%M')"/> 
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <span>CLIENTE</span> <br/>
                                            <span t-esc="doc.customer_ids.name"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <span>TIPO DE INGRESO</span> <br/>
                                            <t t-if="doc.type_entry=='local'">
                                                <span>Local</span>
                                            </t>
                                            <t t-if="doc.type_entry=='harvest'">
                                                <span>Recolección</span>
                                            </t>
                                            <t t-if="doc.type_entry=='home_service'">
                                                <span>Servicio a domicilio</span>
                                            </t>
                                            <t t-if="doc.type_entry=='remote'">
                                                <span>Remoto (a distancia)</span>
                                            </t>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <span>NOTIFICACIÓN</span> <br/>
                                            <span t-esc="doc.type_notification_id.name"/> <br/>
                                            <span t-esc="doc.telephone_cus.name"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            Marca: <span t-esc="doc.brand"/> <br/>
                                            Modelo: <span t-esc="doc.model_e"/> <br/>
                                            Accesorios: 
                                            <t t-if="doc.question_acce=='yes'"><span t-esc="doc.accessories"/></t>
                                            <t t-if="doc.question_acce=='not'"> No </t>
                                            
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <span>Check express status ingreso equipo?</span>
                                            <t t-if="doc.question_check_status=='yes'">
                                                <span>Si</span><br/>
                                            </t>
                                            <t t-if="doc.question_check_status=='not'">
                                                <span>No</span><br/>
                                                <span>Motivo: </span> <span t-esc="doc.question_question_check"/>
                                            </t>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <span t-esc="doc.description"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        
                        <div class="footer d-flex justify-content-center" style="position:absolute; margin:0px; padding:0px; width: 100%; flex-direction: column;">
                            <table class="container mw-100 mb-2 text-center" style="width:100%;">
                                <thead>
                                    <tr>
                                        <th name="th_pie"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>
                                            <span style="font-size: .9rem;">¡Gracias por su preferencia!</span> <br/>
                                            <span style="font-size: .9rem;">Conserve este ticket para la entrega de su equipo.</span> <br/>
                                            <span style="font-size: .9rem;">Al adquirir nuestros servicios acepta las políticas, términos y condiciones estipuladas en nuestra página web www.vazztec.com</span> 
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
