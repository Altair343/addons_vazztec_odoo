<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="service_ticket_temple">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <style>
                        .oe_initial{
                            color: #249e6b;
                        }
                    </style>
                    <div class="header">
                        <div class="container mw-100 mb-2 text-center">
                            <div class="row"></div>
                        </div>
                    </div>
                    <hr/>
                    <table class="container mw-100 mb-2 text-center" style="width:100%">
                        <thead>
                            <tr style="width:100%;">
                                <th name="th_logo" colspan="2">
                                    <img src="/vazz/static/src/img/Logo_Web.png" width="220px" height = "auto"/>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="2">
                                    <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y')" />
                                </td>
                                
                            </tr>
                        </tbody>
                    </table>
                    
                    <div class="page">
                        <div class="container mw-100 mb-2 text-center">
                            <table class="table-bordered" style="border:1px solid black !important; width:100%" border="1px">
                                <thead>
                                    <tr>
                                        <th name="th_folio">FOLIO SERVICIO</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>
                                            <span t-esc="doc.name" class="oe_initial" />
                                        </td>
                                        
                                    </tr>
                                    <tr>
                                        <td>
                                            <span>CLIENTE</span> <br/>
                                            <span t-esc="doc.customer_ids.name"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <span>TIPO DE INGRESO</span> <br/>
                                            <span t-esc="doc.type_entry"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <span>NOTIFICACIÓN</span> <br/>
                                            <span t-esc="doc.type_notification_id.name"/> <br/>
                                            <span t-esc="doc.telephone_cus.name"/>

                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <span t-esc="doc.description"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <br/>
                        <div class="footer d-flex justify-content-center" style="position:absolute; margin:0px; padding:0px; width: 100%; flex-direction: column;">
                            <table class="container mw-100 mb-2 text-center" style="width:100%;">
                                <thead>
                                    <tr>
                                        <th name="th_pie"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>
                                            <span>01XXXX</span> <br/>
                                            <span>RFC</span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>


                        <!-- folio servicio
                        cliente
                        tipo de ingreso
                        descripcion de la falla
                        fecha de impresion del Ticket
                        numero y medio de notificacion del cliente


                        numero de establecimiento
                        rfc del establecimiento -->


                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
