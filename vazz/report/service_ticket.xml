        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <style>
                        
                    </style>
                    <div class="header">
                        <div class="container mw-100 mb-2 text-center">
                            <div class="row"></div>
                        </div>
                    </div>
                    <hr/>
                    <table  style="width:100%">
                        <thead>
