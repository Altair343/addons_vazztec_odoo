<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_quotation_temple">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <style>
                        .oe_title{
                            margin-bottom: 0;
                        }

                        .oe_initial{
                            color: #249e6b;
                        }
                    </style>
                    <div class="header">
                        <div class="container mw-100 mb-2 text-center">
                            <div class="row"></div>
                        </div>
                    </div>
                    <!-- <hr/> -->
                    <table  style="width:100%">
                        <thead>
                            <tr style="width:100%;">
                                <th name="th_logo" colspan="2">
                                    <img src="/vazz/static/src/img/Logo_Web.png" width="220px" height = "auto"/>
                                </th>
                                <th name="th_barra" colspan="4" style="width:100%;">
                                    <img src="/vazz/static/src/img/line.jpg"  width="100%" height = "9px"/>
                                </th>
                            </tr>
                        </thead>
                    </table>
                    
                    <div class="page">
                        <!-- <div class="container mw-100 mb-2 text-center">
                            <p style="text-align:center;" class="oe_title"><strong>Cotización</strong></p>
                        </div> -->
                        <br/>
                        <p style="font-size:0.8rem;" class="oe_title" ><strong>Cotización *</strong></p>
                        <br />
                        <div class="text-left" >
                            <span> <span class="oe_initial">F</span>echa: <span t-esc="context_timestamp(datetime.datetime.now() - datetime.timedelta(hours=6)).strftime('%d/%m/%Y')"></span> </span>
                            <br />
                            <span><span class="oe_initial">C</span>liente: <span t-field="doc.customer_id.folio"/>.<span t-field="doc.customer_id.name"/> </span>
                            <br />
                        </div>
                        <br/>
                        <div class="container mw-100 mb-2 text-center">
                            <table class="table-bordered" style="border:1px solid black !important; width:100%" border="1px">
                                <thead>
                                    <tr>
                                        <th name="th_cantidad"><span class="oe_initial">C</span>antidad</th>
                                        <th name="th_descripcion"><span class="oe_initial">D</span>escripción</th>
                                        <th name="th_unidad"><span class="oe_initial">P</span>recio unitario</th>
                                        <th name="th_precio"><span class="oe_initial">I</span>mporte</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="doc.product_ids">
                                        <t t-foreach="doc.product_ids" t-as="mp">
                                            <tr>
                                                <td>
                                                    <span t-esc="mp.quantity"  />
                                                </td>
                                                <td>
                                                    <span t-esc="mp.description" />
                                                </td>
                                                <td>
                                                    $<span t-esc="mp.unit_price" />
                                                </td>
                                                <td>
                                                    $<span t-esc="mp.amount" />
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                    <tr>
                                        <td colspan="2">
                                        </td>
                                        <td>
                                            <span class="oe_initial">T</span>otal
                                        </td>
                                        <td>
                                            $<span t-esc="doc.total" />
                                        </td>
                                    </tr>
                                        
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="footer d-flex justify-content-center" style="position:absolute; margin:0px; padding:0px; width: 100%; flex-direction: column;">
                        <table class="container mw-100 mb-2 text-center" style="width:100%;">
                            <thead>
                            <tr style="width:100%;">
                                <th class="oe_th" colspan="3">
                                    <hr/>
                                </th>
                            </tr>
                                <tr style="width:100%;">
                                    <th class="oe_th">
                                        <img src="/vazz/static/src/img/email.svg" width="20px" height = "auto"/>
                                        <span>soporte@vazztec.com</span><br/> <br/>

                                        <img src="/vazz/static/src/img/web.svg" width="20px" height = "auto"/>
                                        <span>www.vazztec.com</span>
                                    </th>
                                    <th class="oe_th">
                                        <img src="/vazz/static/src/img/phone.svg" width="20px" height = "auto"/>
                                        <span>982-127-2503</span>
                                    </th>
                                    <th class="oe_th">
                                        <img src="/vazz/static/src/img/ubication.svg" width="20px" height = "auto"/>
                                        <span>
                                            Av. Concordia entre calle 17 y 15B <br/>
                                            Col. Nueva Esperanza <br/>
                                            Champotón, Campeche CP:24400
                                        </span>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td colspan="3">
                                        <br/>
                                            <span style="font-size: 13px;">*Cotización válida por 3 días hábiles de la fecha de cotización, producto sujeto a disponibilidad.</span>
                                        <br/>
                                        <br/>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="3">
                                        Página <span class="page"/> de <span class="topage"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <!-- <div style="display: flex; flex-direction: column; align-items: center;">
                        </div> -->
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
