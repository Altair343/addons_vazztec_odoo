    <record id = "paperformat_ticket" model="report.paperformat">
        <field name="name">Portrait Orientation</field>
        <field name="default" eval="True" />
        <field name="format">Letter</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">20</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">18</field>
        <field name="margin_right">18</field>
    </record>

    <record id = "paperformat_report" model="report.paperformat">
        <field name="name">Portrait Orientation</field>
        <field name="default" eval="True" />
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">43</field>
        <field name="margin_left">18</field>
        <field name="margin_right">18</field>
    </record>

    <record id ="report_quotation" model="ir.actions.report">
        <field name="paperformat_id" ref="paperformat_report"/>
    </record>

    <record id ="service_ticket" model="ir.actions.report">
        <field name="paperformat_id" ref="paperformat_ticket"/>
    </record>
</odoo>