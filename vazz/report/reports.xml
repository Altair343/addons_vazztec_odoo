<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- report_type="qweb-html"
        report_type="qweb-pdf" -->

    <!-- Paper formats -->
    <record id="paperformat_report" model="report.paperformat">
        <field name="name">Reporte Vazztec</field>
        <field name="default" eval="True"/>
        <field name="format">Letter</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">20</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">18</field>
        <field name="margin_right">18</field>
    </record>

    <record id="paperformat_ticket" model="report.paperformat">
        <field name="name">Ticket Vazztec</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field>
        <field name="page_height">150</field>
        <field name="page_width">52</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
    </record>

    <record id="paperformat_ticket_express" model="report.paperformat">
        <field name="name">Ticket Express Vazztec</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field>
        <field name="page_height">150</field>
        <field name="page_width">52</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
    </record>

    <record id="paperformat_check" model="report.paperformat">
        <field name="name">Check Vazztec</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field>
        <field name="page_height">210</field>
        <field name="page_width">52</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
    </record>

    <record id="paperformat_etiquette" model="report.paperformat">
        <field name="name">Etiquette Vazztec</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field>
        <field name="page_height">25</field>
        <field name="page_width">50</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">1</field>
        <field name="margin_bottom">1</field>
        <field name="margin_left">1</field>
        <field name="margin_right">1</field>
    </record>

    <!-- Action reports -->
    <record id="report_quotation" model="ir.actions.report">
        <field name="name">Cotización</field>
        <field name="model">vazz.quotation</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">vazz.report_quotation_temple</field>
        <field name="report_file">vazz.report_quotation</field>
        <field name="print_report_name">object.name</field>
        <field name="paperformat_id" ref="vazz.paperformat_report"/>
        <field name="binding_model_id" ref="model_vazz_quotation"/>
        <field name="binding_type">report</field>
    </record>

    <record id="service_ticket" model="ir.actions.report">
        <field name="name">Ticket</field>
        <field name="model">vazz.services</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">vazz.service_ticket_temple</field>
        <field name="report_file">vazz.service_ticket</field>
        <field name="print_report_name">object.name</field>
        <field name="paperformat_id" ref="vazz.paperformat_ticket"/>
        <field name="binding_model_id" ref="model_vazz_services"/>
        <field name="binding_type">report</field>
    </record>

    <record id="service_express_ticket" model="ir.actions.report">
        <field name="name">Ticket</field>
        <field name="model">vazz.express.service</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">vazz.service_express_ticket_temple</field>
        <field name="report_file">vazz.service_express_ticket</field>
        <field name="print_report_name">object.name</field>
        <field name="paperformat_id" ref="vazz.paperformat_ticket_express"/>
        <field name="binding_model_id" ref="model_vazz_express_service"/>
        <field name="binding_type">report</field>
    </record>

    <record id="check_status_v1" model="ir.actions.report">
        <field name="name">Ticket</field>
        <field name="model">vazz.check.status</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">vazz.check_status_ticket_temple</field>
        <field name="report_file">vazz.check_status_ticket</field>
        <field name="print_report_name">object.name</field>
        <field name="paperformat_id" ref="vazz.paperformat_check"/>
        <!-- Sin binding: no aparece en el menú de impresión -->
    </record>

    <record id="service_etiquette" model="ir.actions.report">
        <field name="name">Etiqueta</field>
        <field name="model">vazz.services</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">vazz.service_etiquette_temple</field>
        <field name="report_file">vazz.service_etiquette</field>
        <field name="print_report_name">object.name</field>
        <field name="paperformat_id" ref="vazz.paperformat_etiquette"/>
        <field name="binding_model_id" ref="model_vazz_services"/>
        <field name="binding_type">report</field>
    </record>

</odoo>