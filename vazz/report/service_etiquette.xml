<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="service_etiquette_temple">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <style>
                        .oe_initial{
                            color: #249e6b;
                        }

                        .oe_pie{
                            font-size: .8rem;
                        }
                    </style>
                    <div class="header">
                        <div class="container mw-100 mb-2 text-center">
                            <div class="row"></div>
                        </div>
                    </div>
                    <div class="page">
                        <table class="container mw-100 mb-2" style="width:100%; text-align:left;">
                            <thead>
                                <tr style="width:100%;">
                                    <th colspan="3"></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr style="width:100%;">
                                    <td colspan="2" style="font-size:10px;">
                                        <strong>Folio de servicio:</strong>
                                        <span t-esc="doc.name" />
                                    </td>
                                    <td name="th_logo">
                                        <img src="/vazz/static/src/img/Logo_Web.png" width="50px" height = "auto"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="3" style="font-size:10px;">
                                        <strong>Fecha:</strong>
                                        <span t-esc="context_timestamp(doc.create_date).strftime('%d/%m/%Y')"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="3" style="font-size:10px;">
                                        <strong>Marca/Modelo:</strong>
                                        <span>
                                            <span t-esc="doc.brand"/>/<span t-esc="doc.model_e"/>
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="3" style="font-size:10px;">
                                        <strong>Nomb. Cliente:</strong>
                                        <span t-esc="doc.customer_ids.name"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
